generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RatingRaterType {
  CITIZEN
  LAWYER
}

enum AssistantConversationStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum RequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MfaRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  action      String
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([action])
  @@index([expiresAt])
  @@map("mfa_rate_limits")
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  password      String?
  name          String
  avatarUrl     String?
  roleId        String
  authProvider  String?
  providerId    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lawyerProfile         LawyerProfile?


  role              Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  reviewedLawyerProfiles LawyerProfile[] @relation("LawyerProfileReviewedBy")
  mfaCodes          MfaCode[]
  emergencyContacts EmergencyContact[]
  assistantConversations  AssistantConversation[]
  citizenRequests       Request[] @relation("CitizenRequests")
  lawyerRequests         Request[] @relation("LawyerRequests")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action], name: "resource_action")
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MfaCode {
  id          String   @id @default(cuid())
  userId      String
  purpose     String
  channel     String
  codeHash    String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("mfa_codes")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

model LawyerProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  barEnrollmentNumber String             @unique
  practiceLicenseUrl  String
  idDocumentUrl       String
  practiceAreas       String[]
  languages           String[]
  yearsOfExperience   Int
  verificationStatus  VerificationStatus @default(PENDING)
  isMatchable         Boolean            @default(false)
  rejectionReason     String?
  reviewedById        String?
  reviewedAt          DateTime?
  rating              Float              @default(0)
  ratingCount         Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LawyerProfileReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@index([isMatchable])
  @@map("lawyer_profiles")
}

model RightsGuide {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  iconKey          String
  shortDescription String
  body             String
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("rights_guides")
}

model RequestRating {
  id           String           @id @default(cuid())
  requestId    String
  raterUserId  String
  raterType    RatingRaterType
  targetUserId String
  rating       Int
  comment      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  request      Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, raterUserId, raterType])
  @@index([requestId])
  @@index([targetUserId])
  @@index([raterUserId])
  @@map("request_ratings")
}

model AssistantConversation {
  id             String                    @id @default(cuid())
  userId         String
  category       String?
  status         AssistantConversationStatus @default(ACTIVE)
  lastMessageAt  DateTime?
  escalatedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]

  @@index([userId])
  @@index([status])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id            String   @id @default(cuid())
  conversationId String
  role          String
  content       String
  category      String?
  disclosure    String?
  isEscalation  Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@map("assistant_messages")
}

model Request {
  id            String        @id @default(cuid())
  citizenId     String
  lawyerId      String?
  category      String
  title         String
  description   String?
  status        RequestStatus @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?
  assignedAt    DateTime?
  cancelledAt   DateTime?

  citizen User  @relation("CitizenRequests", fields: [citizenId], references: [id], onDelete: Cascade)
  lawyer  User? @relation("LawyerRequests", fields: [lawyerId], references: [id], onDelete: SetNull)

  ratings RequestRating[]

  @@index([citizenId])
  @@index([lawyerId])
  @@index([status])
  @@map("requests")
}
